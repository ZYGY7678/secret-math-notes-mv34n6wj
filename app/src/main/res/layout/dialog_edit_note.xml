<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Title Input -->
    <EditText
        android:id="@+id/etTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:hint="@string/title_hint"
        android:padding="12dp"
        android:singleLine="true"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Math Helper Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_calc_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <EditText
            android:id="@+id/etMathInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="חישוב מהיר (למשל: 5*5)"
            android:inputType="text"
            android:padding="4dp"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnQuickCalc"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_button_calc"
            android:minWidth="48dp"
            android:text="="
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Note Content -->
    <EditText
        android:id="@+id/etContent"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_card"
        android:gravity="top|start"
        android:hint="@string/content_hint"
        android:lineSpacingExtra="3dp"
        android:padding="12dp"
        android:scrollbars="vertical"
        android:textColor="@color/text_primary"
        android:textSize="15sp" />

    <!-- Button to evaluate calculations embedded in the text itself -->
    <Button
        android:id="@+id/btnSolveInText"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_button_calc"
        android:text="⚡ פתור את כל החישובים שבתוכן ההערה"
        android:textColor="#FFFFFF"
        android:textSize="13sp" />

</LinearLayout>
